    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet totalBudget = 0;\nlet totalRealise = 0;\nconst details = [];\n\nfor (const item of items) {\n  const cat = item.json.Categorie;\n  const budget = parseFloat(item.json.Budget);\n  const realise = parseFloat(item.json.Realise);\n  const ecartValeur = realise - budget;\n  const ecartPourcent = ((ecartValeur / budget) * 100).toFixed(2);\n\n  totalBudget += budget;\n  totalRealise += realise;\n\n  details.push({\n    categorie: cat,\n    budget: budget,\n    realise: realise,\n    ecart_dollars: ecartValeur,\n    ecart_pourcent: parseFloat(ecartPourcent),\n    alerte: Math.abs(parseFloat(ecartPourcent)) > 15 ? \"CRITIQUE\" : \"NORMAL\"\n  });\n}\n\n// Trier par plus gros écart en valeur absolue\ndetails.sort((a, b) => Math.abs(b.ecart_dollars) - Math.abs(a.ecart_dollars));\n\nreturn [{\n  json: {\n    synthese_globale: {\n      total_budget: totalBudget,\n      total_realise: totalRealise,\n      ecart_net_dollars: totalRealise - totalBudget\n    },\n    lignes_analysees: details\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
